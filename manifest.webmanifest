{
  "name": "DemonEye — the cosmic eye that watches you",
  "short_name": "DemonEye",
  "description": "A cosmic demon eye that follows your mouse, finger or phone tilt — moods, color themes, an audio-reactive soundtrack and the Comet Hunt gaze game.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
